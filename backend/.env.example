# ComputerFlow — environment variables
# Copy to .env and fill in your keys.

# Anthropic (compiler VLM + Computer Use)
ANTHROPIC_API_KEY=sk-ant-...

# Lightcone / Tzafon Northstar  (sandbox + task runner)
LIGHTCONE_API_KEY=sk_YVA0...

# Kernel  (headless cloud browser)
KERNEL_API_KEY=sk_dc50...

# NVIDIA (Brev + NIM inference)
NVIDIA_API_KEY=nvapi-...
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Brev workspace (optional — used by BrevClient CLI wrapper)
BREV_WORKSPACE=

# Compiler backend: "lightcone" (default) or "claude" (uses Claude Sonnet 4.6)
COMPILER=lightcone

# Database (optional — defaults to SQLite at ./data/computerflow.db)
# DATABASE_URL=sqlite:///./data/computerflow.db
